{
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": true,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "HỆ THỐNG PHỤC VỤ MÔ HÌNH (MODEL SERVING STATUS)",
      "type": "row"
    },
    {
      "id": 1,
      "title": "Model Registry Status",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "targets": [
        {
          "expr": "ecommerce_model_info",
          "format": "time_series",
          "legendFormat": "{{algorithm}} ({{stage}} v{{version}})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "green" },
          "mappings": [],
          "unit": "short"
        }
      },
      "options": {
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"], "fields": "" },
        "textMode": "auto"
      }
    },
    {
      "id": 2,
      "title": "Service Uptime",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
      "targets": [
        {
          "expr": "ecommerce_uptime_seconds",
          "format": "time_series",
          "legendFormat": "Uptime"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue", "value": null },
              { "color": "green", "value": 60 }
            ]
          },
          "unit": "s"
        }
      },
      "options": {
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"] }
      }
    },
    {
      "id": 3,
      "title": "Total API Requests",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 1 },
      "targets": [
        {
          "expr": "sum(ecommerce_api_requests_total)",
          "format": "time_series",
          "legendFormat": "Total Requests"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "short"
        }
      },
      "options": {
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"] }
      }
    },
    {
      "id": 4,
      "title": "Data Drift Status",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 },
      "targets": [
        {
          "expr": "ecommerce_data_drift_ratio",
          "format": "time_series",
          "legendFormat": "Drift Share"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.20 },
              { "color": "red", "value": 0.30 }
            ]
          },
          "unit": "percentunit"
        }
      },
      "options": {
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"] }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "id": 101,
      "title": "QUẢN TRỊ TỒN KHO & CẢNH BÁO NHẬP HÀNG (INVENTORY ALERTS)",
      "type": "row"
    },
    {
      "id": 5,
      "title": "🔴 CRITICAL (Báo động đỏ: Tồn kho <= Safety Stock)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 8, "x": 0, "y": 6 },
      "targets": [
        {
          "expr": "ecommerce_inventory_alerts_total{level=\"critical\"}",
          "format": "time_series",
          "legendFormat": "Critical SKUs"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "red" },
          "unit": "short"
        }
      },
      "options": {
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"] }
      }
    },
    {
      "id": 6,
      "title": "🟡 WARNING (Cảnh báo vàng: Tồn kho <= Reorder Point)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 8, "x": 8, "y": 6 },
      "targets": [
        {
          "expr": "ecommerce_inventory_alerts_total{level=\"warning\"}",
          "format": "time_series",
          "legendFormat": "Warning SKUs"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "yellow" },
          "unit": "short"
        }
      },
      "options": {
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"] }
      }
    },
    {
      "id": 7,
      "title": "🟢 NORMAL (Tồn kho an toàn > Reorder Point)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 8, "x": 16, "y": 6 },
      "targets": [
        {
          "expr": "ecommerce_inventory_alerts_total{level=\"normal\"}",
          "format": "time_series",
          "legendFormat": "Normal SKUs"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "green" },
          "unit": "short"
        }
      },
      "options": {
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"] }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 10 },
      "id": 102,
      "title": "LƯU LƯỢNG YÊU CẦU & HIỆU NĂNG PHỤC VỤ (TRAFFIC & LATENCY)",
      "type": "row"
    },
    {
      "id": 8,
      "title": "API Request Rate (RPS by Endpoint)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 16, "x": 0, "y": 11 },
      "targets": [
        {
          "expr": "rate(ecommerce_api_requests_total[1m])",
          "format": "time_series",
          "legendFormat": "{{endpoint}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "showPoints": "auto",
            "fillOpacity": 15
          },
          "unit": "reqps"
        }
      }
    },
    {
      "id": 9,
      "title": "Tỷ lệ phân bố trạng thái kho hàng",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 11 },
      "targets": [
        {
          "expr": "ecommerce_inventory_alerts_total",
          "format": "time_series",
          "legendFormat": "{{level}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" }
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 19 },
      "id": 103,
      "title": "ĐỘ SẴN SÀNG, FALLBACK & ĐỘ TRỄ (RELIABILITY)",
      "type": "row"
    },
    {
      "id": 10,
      "title": "Model Ready",
      "type": "stat",
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 20 },
      "targets": [
        { "expr": "ecommerce_model_ready", "format": "time_series", "legendFormat": "Ready" }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "options": { "0": { "text": "NOT READY", "color": "red" }, "1": { "text": "READY", "color": "green" } }, "type": "value" }
          ],
          "unit": "short"
        }
      },
      "options": { "reduceOptions": { "values": false, "calcs": ["lastNotNull"] }, "textMode": "value" }
    },
    {
      "id": 11,
      "title": "Heuristic Fallback Forecasts / sec",
      "type": "timeseries",
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 20 },
      "targets": [
        { "expr": "sum(rate(ecommerce_predictions_total{model_source=~\"heuristic.*\"}[5m]))", "format": "time_series", "legendFormat": "Fallback forecasts" }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps", "color": { "mode": "fixed", "fixedColor": "orange" } } }
    },
    {
      "id": 12,
      "title": "API Latency P95 by Endpoint",
      "type": "timeseries",
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 20 },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum by (le, endpoint) (rate(ecommerce_api_request_duration_seconds_bucket[5m])))", "format": "time_series", "legendFormat": "{{endpoint}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "color": { "mode": "palette-classic" } } }
    },
    {
      "id": 13,
      "title": "API Latency P99 by Endpoint",
      "type": "timeseries",
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 20 },
      "targets": [
        { "expr": "histogram_quantile(0.99, sum by (le, endpoint) (rate(ecommerce_api_request_duration_seconds_bucket[5m])))", "format": "time_series", "legendFormat": "{{endpoint}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "color": { "mode": "palette-classic" } } }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 25 },
      "id": 104,
      "title": "TRAINING DATA READINESS",
      "type": "row"
    },
    {
      "id": 14,
      "title": "Trạng thái dữ liệu huấn luyện",
      "type": "stat",
      "gridPos": { "h": 5, "w": 8, "x": 0, "y": 26 },
      "targets": [
        { "expr": "ecommerce_training_data_sufficient", "format": "time_series", "legendFormat": "Training readiness" }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "options": { "-1": { "text": "CHƯA ĐÁNH GIÁ", "color": "gray" }, "0": { "text": "THIẾU LỊCH SỬ", "color": "red" }, "1": { "text": "ĐỦ DỮ LIỆU", "color": "green" } }, "type": "value" }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "gray", "value": null },
              { "color": "red", "value": 0 },
              { "color": "green", "value": 1 }
            ]
          },
          "unit": "short"
        }
      },
      "options": {
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"], "fields": "" },
        "textMode": "value"
      }
    },
    {
      "id": 15,
      "title": "Coverage lịch sử: hiện có / yêu cầu (ngày)",
      "type": "timeseries",
      "gridPos": { "h": 5, "w": 10, "x": 8, "y": 26 },
      "targets": [
        { "expr": "ecommerce_training_history_days{kind=\"available\"}", "format": "time_series", "legendFormat": "Hiện có" },
        { "expr": "ecommerce_training_history_days{kind=\"required\"}", "format": "time_series", "legendFormat": "Yêu cầu tối thiểu" }
      ],
      "fieldConfig": { "defaults": { "unit": "d", "color": { "mode": "palette-classic" } } }
    },
    {
      "id": 16,
      "title": "Cần nạp thêm (ngày)",
      "type": "stat",
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 26 },
      "targets": [
        { "expr": "ecommerce_training_history_days{kind=\"missing\"}", "format": "time_series", "legendFormat": "Ngày còn thiếu" }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          },
          "unit": "d"
        }
      },
      "options": { "reduceOptions": { "values": false, "calcs": ["lastNotNull"] }, "textMode": "value" }
    }
  ],
  "refresh": "10s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["mlops", "ecommerce", "demand-forecasting", "inventory"],
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": ["5s", "10s", "30s", "1m", "5m"]
  },
  "timezone": "browser",
  "title": "E-Commerce Streaming MLOps: Serving, Inventory & Training Readiness Dashboard",
  "uid": "ecom-mlops-dashboard",
  "version": 1
}
