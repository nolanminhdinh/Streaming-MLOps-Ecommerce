{
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": true,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "HỆ THỐNG PHỤC VỤ MÔ HÌNH (MODEL SERVING STATUS)",
      "type": "row"
    },
    {
      "id": 1,
      "title": "Model Registry Status",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "targets": [
        {
          "expr": "ecommerce_model_info",
          "format": "time_series",
          "legendFormat": "{{algorithm}} ({{stage}} v{{version}})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "green" },
          "mappings": [],
          "unit": "short"
        }
      },
      "options": {
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"], "fields": "" },
        "textMode": "auto"
      }
    },
    {
      "id": 2,
      "title": "Service Uptime",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
      "targets": [
        {
          "expr": "ecommerce_uptime_seconds",
          "format": "time_series",
          "legendFormat": "Uptime"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue", "value": null },
              { "color": "green", "value": 60 }
            ]
          },
          "unit": "s"
        }
      },
      "options": {
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"] }
      }
    },
    {
      "id": 3,
      "title": "Total API Requests",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 1 },
      "targets": [
        {
          "expr": "sum(ecommerce_api_requests_total)",
          "format": "time_series",
          "legendFormat": "Total Requests"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "short"
        }
      },
      "options": {
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"] }
      }
    },
    {
      "id": 4,
      "title": "Data Drift Status",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 },
      "targets": [
        {
          "expr": "ecommerce_data_drift_ratio",
          "format": "time_series",
          "legendFormat": "Drift Share"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.20 },
              { "color": "red", "value": 0.30 }
            ]
          },
          "unit": "percentunit"
        }
      },
      "options": {
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"] }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "id": 101,
      "title": "QUẢN TRỊ TỒN KHO & CẢNH BÁO NHẬP HÀNG (INVENTORY ALERTS)",
      "type": "row"
    },
    {
      "id": 5,
      "title": "🔴 CRITICAL (Báo động đỏ: Tồn kho <= Safety Stock)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 8, "x": 0, "y": 6 },
      "targets": [
        {
          "expr": "ecommerce_inventory_alerts_total{level=\"critical\"}",
          "format": "time_series",
          "legendFormat": "Critical SKUs"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "red" },
          "unit": "short"
        }
      },
      "options": {
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"] }
      }
    },
    {
      "id": 6,
      "title": "🟡 WARNING (Cảnh báo vàng: Tồn kho <= Reorder Point)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 8, "x": 8, "y": 6 },
      "targets": [
        {
          "expr": "ecommerce_inventory_alerts_total{level=\"warning\"}",
          "format": "time_series",
          "legendFormat": "Warning SKUs"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "yellow" },
          "unit": "short"
        }
      },
      "options": {
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"] }
      }
    },
    {
      "id": 7,
      "title": "🟢 NORMAL (Tồn kho an toàn > Reorder Point)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 8, "x": 16, "y": 6 },
      "targets": [
        {
          "expr": "ecommerce_inventory_alerts_total{level=\"normal\"}",
          "format": "time_series",
          "legendFormat": "Normal SKUs"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "green" },
          "unit": "short"
        }
      },
      "options": {
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"] }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 10 },
      "id": 102,
      "title": "LƯU LƯỢNG YÊU CẦU & HIỆU NĂNG PHỤC VỤ (TRAFFIC & LATENCY)",
      "type": "row"
    },
    {
      "id": 8,
      "title": "API Request Rate (RPS by Endpoint)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 16, "x": 0, "y": 11 },
      "targets": [
        {
          "expr": "rate(ecommerce_api_requests_total[1m])",
          "format": "time_series",
          "legendFormat": "{{endpoint}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "showPoints": "auto",
            "fillOpacity": 15
          },
          "unit": "reqps"
        }
      }
    },
    {
      "id": 9,
      "title": "Tỷ lệ phân bố trạng thái kho hàng",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 11 },
      "targets": [
        {
          "expr": "ecommerce_inventory_alerts_total",
          "format": "time_series",
          "legendFormat": "{{level}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" }
        }
      }
    }
  ],
  "refresh": "10s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["mlops", "ecommerce", "demand-forecasting", "inventory"],
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": ["5s", "10s", "30s", "1m", "5m"]
  },
  "timezone": "browser",
  "title": "E-Commerce Streaming MLOps: Serving & Inventory Dashboard",
  "uid": "ecom-mlops-dashboard",
  "version": 1
}
