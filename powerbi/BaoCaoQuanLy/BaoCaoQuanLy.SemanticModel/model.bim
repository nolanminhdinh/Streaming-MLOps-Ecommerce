            "sourceColumn": "confirmed_label",
            "summarizeBy": "none"
          },
          {
            "name": "Last 30 Days",
            "dataType": "boolean",
            "expression": "dim_date[full_date] >= TODAY () - 30 && dim_date[full_date] <= TODAY ()",
            "lineageTag": "68c0744faaf1b63daece6aafe929d09d",
            "summarizeBy": "none",
            "type": "calculated"
          },
          {
            "name": "Last 60 Days",
            "dataType": "boolean",
            "expression": "dim_date[full_date] >= TODAY () - 60 && dim_date[full_date] <= TODAY ()",
            "lineageTag": "7b0b240db36354bfd248a1b6b737fd23",
            "summarizeBy": "none",
            "type": "calculated"
          },
          {
            "name": "Forecast Window",
            "dataType": "boolean",
            "expression": "dim_date[full_date] >= TODAY () - 60 && dim_date[full_date] <= TODAY () + 14",
            "lineageTag": "d3abd37ad24c5a07d948bc74ee8401a9",
            "summarizeBy": "none",
            "type": "calculated"
          }
        ],
        "dataCategory": "Time",
        "lineageTag": "878f480f6c40b9ac9a935c1c350975f9",
        "partitions": [
          {
            "name": "dim_date",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    Source = PostgreSQL.Database(pServer, pDatabase),",
                "    Data = Source{[Schema=\"mart\",Item=\"dim_date\"]}[Data],",
                "    Selected = Table.SelectColumns(Data, {\"date_key\", \"full_date\", \"day_of_month\", \"iso_day_of_week\", \"day_name_vi\", \"iso_week\", \"month\", \"month_label\", \"quarter\", \"year\", \"year_month\", \"year_month_label\", \"is_weekend\", \"is_mega_sale\", \"is_data_confirmed\"}),",
                "    Typed = Table.TransformColumnTypes(Selected, {{\"date_key\", Int64.Type}, {\"full_date\", type date}, {\"day_of_month\", Int64.Type}, {\"iso_day_of_week\", Int64.Type}, {\"day_name_vi\", type text}, {\"iso_week\", Int64.Type}, {\"month\", Int64.Type}, {\"month_label\", type text}, {\"quarter\", Int64.Type}, {\"year\", Int64.Type}, {\"year_month\", Int64.Type}, {\"year_month_label\", type text}, {\"is_weekend\", type logical}, {\"is_mega_sale\", type logical}, {\"is_data_confirmed\", type logical}}),",
                "    Added0 = Table.AddColumn(Typed, \"confirmed_label\", each if [is_data_confirmed] = true then \"Đã xác nhận\" else \"Chưa xác nhận\", type text)",
                "in",
                "    Added0"
              ],
              "type": "m"
            }
          }
        ]
