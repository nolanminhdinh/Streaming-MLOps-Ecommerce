                "    Typed = Table.TransformColumnTypes(Selected, {{\"product_key\", Int64.Type}, {\"evaluation_date_key\", Int64.Type}, {\"model_key\", Int64.Type}, {\"inventory_date_key\", Int64.Type}, {\"inventory_age_days\", Int64.Type}, {\"on_hand\", Int64.Type}, {\"lead_time_days\", Int64.Type}, {\"lead_time_defaulted\", type logical}, {\"service_level\", type number}, {\"sigma_daily\", type number}, {\"avg_daily_demand\", type number}, {\"demand_lead_time\", type number}, {\"forecast_next_7d\", type number}, {\"demand_source\", type text}, {\"safety_stock\", type number}, {\"reorder_point\", type number}, {\"order_up_to\", type number}, {\"days_of_cover\", type number}, {\"action_status\", type text}, {\"urgency\", type text}, {\"recommended_order_qty\", type number}, {\"projected_stockout_date\", type date}, {\"order_by_date\", type date}, {\"order_value_at_selling_price\", type number}, {\"reason\", type text}}),",
                "    Added0 = Table.AddColumn(Typed, \"status_order\", each if [action_status] = \"CRITICAL\" then 1 else if [action_status] = \"REORDER\" then 2 else if [action_status] = \"NO_DEMAND_DATA\" then 3 else if [action_status] = \"OK\" then 4 else 9, Int64.Type)",
