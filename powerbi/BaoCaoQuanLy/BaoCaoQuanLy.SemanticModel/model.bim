      {
        "name": "_Measures",
        "columns": [
          {
            "name": "Value",
            "dataType": "int64",
            "isDataTypeInferred": true,
            "isHidden": true,
            "isNameInferred": true,
            "lineageTag": "38147563db97db0119cc5fbadd2aa4cc",
            "sourceColumn": "[Value]",
            "summarizeBy": "none",
            "type": "calculatedTableColumn"
          }
        ],
        "lineageTag": "f735656f2685b2dc1d3166e59d4d9a6d",
        "measures": [
          {
            "name": "Orders",
            "displayFolder": "1. Đơn hàng sàn",
            "expression": "CALCULATE ( COUNTROWS ( fact_sales_order ), fact_sales_order[is_cancelled] = FALSE () )",
            "formatString": "#,0",
            "lineageTag": "3e044accf9038b0c6eb1d9e895bebcfc"
          },
          {
            "name": "Orders All Status",
            "displayFolder": "1. Đơn hàng sàn",
            "expression": "COUNTROWS ( fact_sales_order )",
            "formatString": "#,0",
            "lineageTag": "10be7dcaa08a85c04401344443751417"
          },
          {
            "name": "Cancelled Orders",
            "displayFolder": "1. Đơn hàng sàn",
            "expression": "CALCULATE ( COUNTROWS ( fact_sales_order ), fact_sales_order[is_cancelled] = TRUE () )",
            "formatString": "#,0",
            "lineageTag": "de418eb8c452a2b773d26ea3f7e4180d"
          },
          {
            "name": "Cancel Rate",
            "displayFolder": "1. Đơn hàng sàn",
            "expression": "DIVIDE ( [Cancelled Orders], [Orders All Status] )",
            "formatString": "0.0%;-0.0%;0.0%",
            "lineageTag": "96d1dcffdf36fb1ce876ea04bc5c2875"
          },
          {
            "name": "Net Revenue",
            "displayFolder": "1. Đơn hàng sàn",
            "expression": "SUM ( fact_sales_order[net_amount] )",
            "lineageTag": "345bef0b09c770ce9570002458c11a52",
            "formatStringDefinition": {
              "expression": "VAR v = SELECTEDMEASURE ()\nVAR a = ABS ( v )\nVAR t =\n    SWITCH ( TRUE (),\n        a >= 1E9, FORMAT ( v / 1E9, \"#,0.0\" ) & \" tỷ ₫\",\n        a >= 1E6, FORMAT ( v / 1E6, \"#,0.0\" ) & \" triệu ₫\",\n        a >= 1E3, FORMAT ( v / 1E3, \"#,0\" ) & \" nghìn ₫\",\n        FORMAT ( v, \"#,0\" ) & \" ₫\" )\nRETURN \"\"\"\" & t & \"\"\"\""
            }
          },
          {
            "name": "Units Sold",
            "displayFolder": "1. Đơn hàng sàn",
            "expression": "SUM ( fact_sales_line[net_quantity] )",
            "formatString": "#,0",
            "lineageTag": "c7f23cfe0783e3ca306d5706eb36c969"
          },
          {
            "name": "AOV",
            "displayFolder": "1. Đơn hàng sàn",
            "expression": "DIVIDE ( [Net Revenue], [Orders] )",
            "lineageTag": "d9c1434c41ca353eed20327da007b7ed",
            "formatStringDefinition": {
              "expression": "VAR v = SELECTEDMEASURE ()\nVAR a = ABS ( v )\nVAR t =\n    SWITCH ( TRUE (),\n        a >= 1E9, FORMAT ( v / 1E9, \"#,0.0\" ) & \" tỷ ₫\",\n        a >= 1E6, FORMAT ( v / 1E6, \"#,0.0\" ) & \" triệu ₫\",\n        a >= 1E3, FORMAT ( v / 1E3, \"#,0\" ) & \" nghìn ₫\",\n        FORMAT ( v, \"#,0\" ) & \" ₫\" )\nRETURN \"\"\"\" & t & \"\"\"\""
            }
          },
          {
            "name": "Platform Fees",
            "displayFolder": "1. Đơn hàng sàn",
            "expression": "SUM ( fact_sales_order[platform_fees] )",
            "lineageTag": "beb5d8c6c3ad6bfb681c36714dea704f",
            "formatStringDefinition": {
              "expression": "VAR v = SELECTEDMEASURE ()\nVAR a = ABS ( v )\nVAR t =\n    SWITCH ( TRUE (),\n        a >= 1E9, FORMAT ( v / 1E9, \"#,0.0\" ) & \" tỷ ₫\",\n        a >= 1E6, FORMAT ( v / 1E6, \"#,0.0\" ) & \" triệu ₫\",\n        a >= 1E3, FORMAT ( v / 1E3, \"#,0\" ) & \" nghìn ₫\",\n        FORMAT ( v, \"#,0\" ) & \" ₫\" )\nRETURN \"\"\"\" & t & \"\"\"\""
            }
          },
          {
            "name": "Avg Hours To Complete",
            "displayFolder": "1. Đơn hàng sàn",
            "expression": "CALCULATE ( AVERAGE ( fact_sales_order[hours_to_complete] ), fact_sales_order[is_cancelled] = FALSE () )",
            "formatString": "#,0.0",
            "lineageTag": "41b169966d76db441b3dc9e2d1bd4f86"
          },
          {
            "name": "Revenue Last 7D",
            "displayFolder": "1. Đơn hàng sàn",
            "expression": [
              "VAR LastDay = MIN ( MAX ( dim_date[full_date] ), TODAY () - 1 )",
              "RETURN CALCULATE ( [Net Revenue], DATESINPERIOD ( dim_date[full_date], LastDay, -7, DAY ) )"
            ],
            "lineageTag": "7c72bb0d83cab45855983c02ac8a9cf0",
            "formatStringDefinition": {
              "expression": "VAR v = SELECTEDMEASURE ()\nVAR a = ABS ( v )\nVAR t =\n    SWITCH ( TRUE (),\n        a >= 1E9, FORMAT ( v / 1E9, \"#,0.0\" ) & \" tỷ ₫\",\n        a >= 1E6, FORMAT ( v / 1E6, \"#,0.0\" ) & \" triệu ₫\",\n        a >= 1E3, FORMAT ( v / 1E3, \"#,0\" ) & \" nghìn ₫\",\n        FORMAT ( v, \"#,0\" ) & \" ₫\" )\nRETURN \"\"\"\" & t & \"\"\"\""
            }
          },
          {
            "name": "Revenue Prev 7D",
            "displayFolder": "1. Đơn hàng sàn",
            "expression": [
              "VAR LastDay = MIN ( MAX ( dim_date[full_date] ), TODAY () - 1 )",
              "RETURN CALCULATE ( [Net Revenue], DATESINPERIOD ( dim_date[full_date], LastDay - 7, -7, DAY ) )"
            ],
            "lineageTag": "a31bd39bbb41987978a6a2c3922b2ece",
            "formatStringDefinition": {
              "expression": "VAR v = SELECTEDMEASURE ()\nVAR a = ABS ( v )\nVAR t =\n    SWITCH ( TRUE (),\n        a >= 1E9, FORMAT ( v / 1E9, \"#,0.0\" ) & \" tỷ ₫\",\n        a >= 1E6, FORMAT ( v / 1E6, \"#,0.0\" ) & \" triệu ₫\",\n        a >= 1E3, FORMAT ( v / 1E3, \"#,0\" ) & \" nghìn ₫\",\n        FORMAT ( v, \"#,0\" ) & \" ₫\" )\nRETURN \"\"\"\" & t & \"\"\"\""
            }
          },
          {
            "name": "Revenue 7D Change %",
            "displayFolder": "1. Đơn hàng sàn",
            "expression": "DIVIDE ( [Revenue Last 7D] - [Revenue Prev 7D], [Revenue Prev 7D] )",
            "formatString": "0.0%;-0.0%;0.0%",
            "lineageTag": "6e1c1488a87a27f738754b6c6e75c2a4"
          },
          {
            "name": "Revenue Share",
            "displayFolder": "1. Đơn hàng sàn",
            "expression": "DIVIDE ( [Net Revenue], CALCULATE ( [Net Revenue], ALL ( dim_platform ) ) )",
            "formatString": "0.0%;-0.0%;0.0%",
            "lineageTag": "95097ea1dad76ebd38afcad1543fb8d9"
          },
          {
            "name": "SKUs Tracked Today",
            "displayFolder": "2. Tồn kho",
            "expression": "CALCULATE ( COUNTROWS ( fact_replenishment_daily ), fact_replenishment_daily[Is Latest Evaluation] = TRUE (), REMOVEFILTERS ( dim_date ) )",
            "formatString": "#,0",
            "lineageTag": "85e00d36e90f63545bd19efd7ed85bfc"
          },
          {
            "name": "SKUs Critical",
            "displayFolder": "2. Tồn kho",
            "expression": "CALCULATE ( [SKUs Tracked Today], fact_replenishment_daily[action_status] = \"CRITICAL\" )",
            "formatString": "#,0",
            "lineageTag": "44bb5e613229d3c40f575e2edec847a9"
          },
          {
            "name": "SKUs To Reorder",
            "displayFolder": "2. Tồn kho",
            "expression": "CALCULATE ( [SKUs Tracked Today], fact_replenishment_daily[action_status] IN { \"CRITICAL\", \"REORDER\" } )",
            "formatString": "#,0",
            "lineageTag": "22b35ba2ba8d184f2022957bce1089ae"
          },
          {
            "name": "SKUs OK",
            "displayFolder": "2. Tồn kho",
            "expression": "CALCULATE ( [SKUs Tracked Today], fact_replenishment_daily[action_status] = \"OK\" )",
            "formatString": "#,0",
            "lineageTag": "0011b72c775787d3c67d74b052fcb03b"
          },
          {
            "name": "SKUs No Demand Data",
            "displayFolder": "2. Tồn kho",
            "expression": "CALCULATE ( [SKUs Tracked Today], fact_replenishment_daily[action_status] = \"NO_DEMAND_DATA\" )",
            "formatString": "#,0",
            "lineageTag": "b23598c14299681991a41dca79e74d79"
          },
          {
            "name": "SKUs Stockout 7d",
            "displayFolder": "2. Tồn kho",
            "expression": "CALCULATE ( COUNTROWS ( FILTER ( fact_replenishment_daily, NOT ISBLANK ( fact_replenishment_daily[days_of_cover] ) && fact_replenishment_daily[days_of_cover] <= 7 ) ), fact_replenishment_daily[Is Latest Evaluation] = TRUE (), REMOVEFILTERS ( dim_date ) )",
            "formatString": "#,0",
            "lineageTag": "d58117ee56bbe085c98846283bcdfa49"
          },
          {
            "name": "Stock On Hand Today",
            "displayFolder": "2. Tồn kho",
            "expression": "CALCULATE ( SUM ( fact_replenishment_daily[on_hand] ), fact_replenishment_daily[Is Latest Evaluation] = TRUE (), REMOVEFILTERS ( dim_date ) )",
            "formatString": "#,0",
            "lineageTag": "3fdff87ff81bf6e04ba52b7b8fc01d65"
          },
          {
            "name": "Reorder Point Today",
            "displayFolder": "2. Tồn kho",
            "expression": "CALCULATE ( SUM ( fact_replenishment_daily[reorder_point] ), fact_replenishment_daily[Is Latest Evaluation] = TRUE (), REMOVEFILTERS ( dim_date ) )",
            "formatString": "#,0",
            "lineageTag": "2f96de587a89ff9577a0faa6a4ab2890"
          },
          {
            "name": "Median Days Of Cover",
            "displayFolder": "2. Tồn kho",
            "expression": "CALCULATE ( MEDIAN ( fact_replenishment_daily[days_of_cover] ), fact_replenishment_daily[Is Latest Evaluation] = TRUE (), REMOVEFILTERS ( dim_date ) )",
            "formatString": "#,0.0",
            "lineageTag": "6db3bb437cf85d33f1e964fe4ffca277"
          },
          {
            "name": "Days Of Cover Today",
            "displayFolder": "2. Tồn kho",
            "expression": "CALCULATE ( MIN ( fact_replenishment_daily[days_of_cover] ), fact_replenishment_daily[Is Latest Evaluation] = TRUE (), REMOVEFILTERS ( dim_date ) )",
            "formatString": "#,0.0",
            "lineageTag": "6fd294a0b759e1e80ab8e0f1b4322607"
          },
          {
            "name": "Stock Snapshot",
            "displayFolder": "2. Tồn kho",
            "expression": [
              "VAR d = MAX ( dim_date[full_date] )",
              "RETURN SUMX ( VALUES ( dim_product[product_key] ),",
              "    VAR LastKey = CALCULATE ( MAX ( fact_inventory_daily[snapshot_date_key] ), dim_date[full_date] <= d, REMOVEFILTERS ( dim_date ) )",
              "    RETURN IF ( NOT ISBLANK ( LastKey ), CALCULATE ( SUM ( fact_inventory_daily[on_hand] ),",
              "        fact_inventory_daily[snapshot_date_key] = LastKey, REMOVEFILTERS ( dim_date ) ) ) )"
            ],
            "formatString": "#,0",
            "lineageTag": "6bb3ab38f257a92b9cabb50028c4eb7f"
          },
          {
            "name": "Status Color",
            "displayFolder": "2. Tồn kho",
            "expression": [
              "VAR s = CALCULATE ( SELECTEDVALUE ( fact_replenishment_daily[action_status] ), fact_replenishment_daily[Is Latest Evaluation] = TRUE (), REMOVEFILTERS ( dim_date ) )",
              "RETURN SWITCH ( s, \"CRITICAL\", \"#D64545\", \"REORDER\", \"#E8912D\", \"OK\", \"#3A9D5D\", \"NO_DEMAND_DATA\", \"#9AA0A6\", \"#C8C8C8\" )"
            ],
            "lineageTag": "c9e08311311c7d8cfe531a0fc9bcc623"
          },
          {
            "name": "Reason Today",
            "displayFolder": "2. Tồn kho",
            "expression": "CALCULATE ( SELECTEDVALUE ( fact_replenishment_daily[reason] ), fact_replenishment_daily[Is Latest Evaluation] = TRUE (), REMOVEFILTERS ( dim_date ) )",
            "lineageTag": "029dc2fc3203240f51b2a1e6edbcd6b9"
          },
          {
            "name": "Forecast Units",
            "displayFolder": "3. Dự báo AI",
            "expression": "CALCULATE ( SUM ( fact_demand_forecast[predicted_quantity] ), fact_demand_forecast[is_latest_for_target] = TRUE (), dim_model[training_data_origin] = \"warehouse_live\" )",
            "formatString": "#,0.0",
            "lineageTag": "0ae5f61977ab6551d55975c214c72567"
          },
          {
            "name": "Forecast Upper",
            "displayFolder": "3. Dự báo AI",
            "expression": "IF ( HASONEVALUE ( dim_product[sku] ), CALCULATE ( SUM ( fact_demand_forecast[upper_bound] ), fact_demand_forecast[is_latest_for_target] = TRUE (), dim_model[training_data_origin] = \"warehouse_live\" ) )",
            "formatString": "#,0.0",
            "lineageTag": "adc513d288afce81c665522c08f376c7"
          },
          {
            "name": "Forecast Lower",
            "displayFolder": "3. Dự báo AI",
            "expression": "IF ( HASONEVALUE ( dim_product[sku] ), CALCULATE ( SUM ( fact_demand_forecast[lower_bound] ), fact_demand_forecast[is_latest_for_target] = TRUE (), dim_model[training_data_origin] = \"warehouse_live\" ) )",
            "formatString": "#,0.0",
            "lineageTag": "135163b33977446347ccc54cc3576f38"
          },
          {
            "name": "Actual Units",
            "displayFolder": "3. Dự báo AI",
            "expression": "SUM ( fact_sales_line[net_quantity] )",
            "formatString": "#,0",
            "lineageTag": "140b69a8854e16bd3917d737812799f0"
          },
          {
            "name": "Scored Forecast Error",
            "displayFolder": "3. Dự báo AI",
            "expression": "CALCULATE ( SUM ( fact_demand_forecast[absolute_error] ), fact_demand_forecast[actual_complete] = TRUE () )",
            "formatString": "#,0.0",
            "lineageTag": "ce366c18b866597b368c4a242254b8bd"
          },
          {
            "name": "Scored Actual",
            "displayFolder": "3. Dự báo AI",
            "expression": "CALCULATE ( SUM ( fact_demand_forecast[actual_quantity] ), fact_demand_forecast[actual_complete] = TRUE () )",
            "formatString": "#,0.0",
            "lineageTag": "f5792f0284315987acb0344e95507d68"
          },
          {
            "name": "Scored Predicted",
            "displayFolder": "3. Dự báo AI",
            "expression": "CALCULATE ( SUM ( fact_demand_forecast[predicted_quantity] ), fact_demand_forecast[actual_complete] = TRUE () )",
            "formatString": "#,0.0",
            "lineageTag": "646c214c1a76b38c0de9d021bcdf5e67"
          },
          {
            "name": "Live WAPE",
            "displayFolder": "3. Dự báo AI",
            "expression": "DIVIDE ( [Scored Forecast Error], [Scored Actual] )",
            "formatString": "0.0%;-0.0%;0.0%",
            "lineageTag": "ec21cd262b390ddc00473cdf327aae45"
          },
          {
            "name": "Live Bias",
            "displayFolder": "3. Dự báo AI",
            "expression": "DIVIDE ( [Scored Predicted] - [Scored Actual], [Scored Actual] )",
            "formatString": "0.0%;-0.0%;0.0%",
            "lineageTag": "88d3091755865264390400acf3f643bf"
          },
          {
            "name": "Scored Days",
            "displayFolder": "3. Dự báo AI",
            "expression": "CALCULATE ( DISTINCTCOUNT ( fact_demand_forecast[target_date_key] ), fact_demand_forecast[actual_complete] = TRUE () )",
            "formatString": "#,0",
            "lineageTag": "8d804abf324a50723e281e9964610c6a"
          },
          {
            "name": "Serving Live WAPE",
            "displayFolder": "3. Dự báo AI",
            "expression": "CALCULATE ( [Live WAPE], dim_model[is_serving] = TRUE (), fact_demand_forecast[horizon_days] = 1 )",
            "formatString": "0.0%;-0.0%;0.0%",
            "lineageTag": "9c97a9b74bd701c07cf3dea1aaf2205a"
          },
          {
            "name": "Serving Live Bias",
            "displayFolder": "3. Dự báo AI",
            "expression": "CALCULATE ( [Live Bias], dim_model[is_serving] = TRUE (), fact_demand_forecast[horizon_days] = 1 )",
            "formatString": "0.0%;-0.0%;0.0%",
            "lineageTag": "1685c6727f9290d96a0dd64c8d78bc6c"
          },
          {
            "name": "Serving Scored Days",
            "displayFolder": "3. Dự báo AI",
            "expression": "CALCULATE ( [Scored Days], dim_model[is_serving] = TRUE (), fact_demand_forecast[horizon_days] = 1 )",
            "formatString": "#,0",
            "lineageTag": "368ec955a0a7c632454c5933651c5971"
          },
          {
            "name": "Scored Forecasts",
            "displayFolder": "3. Dự báo AI",
            "expression": "CALCULATE ( COUNTROWS ( fact_demand_forecast ), fact_demand_forecast[actual_complete] = TRUE () )",
            "formatString": "#,0",
            "lineageTag": "9ded40fe78df95001a8757c4a02a2061"
          },
          {
            "name": "Backtest WAPE",
            "displayFolder": "3. Dự báo AI",
            "expression": "DIVIDE ( CALCULATE ( MAX ( dim_model[cv_wape] ), dim_model[is_serving] = TRUE () ), 100 )",
            "formatString": "0.0%;-0.0%;0.0%",
            "lineageTag": "061368e96f020b92d8d6045abb09239f"
          },
          {
            "name": "Backtest Bias",
            "displayFolder": "3. Dự báo AI",
            "expression": "DIVIDE ( CALCULATE ( MAX ( dim_model[cv_bias] ), dim_model[is_serving] = TRUE () ), 100 )",
            "formatString": "0.0%;-0.0%;0.0%",
            "lineageTag": "9728d085c5874374fc98adca75c37377"
          },
          {
            "name": "Serving Model",
            "displayFolder": "3. Dự báo AI",
            "expression": "CALCULATE ( MAX ( dim_model[version_label] ), dim_model[is_serving] = TRUE () )",
            "lineageTag": "f0b4f6ef048fd27473c347e9747c679f"
          },
          {
            "name": "Common WAPE",
            "displayFolder": "3. Dự báo AI",
            "expression": [
              "VAR NModels = CALCULATE ( DISTINCTCOUNT ( fact_demand_forecast[model_key] ), fact_demand_forecast[actual_complete] = TRUE (), ALLSELECTED ( dim_model ) )",
              "VAR CommonKeys =",
              "    FILTER (",
              "        CALCULATETABLE (",
              "            SUMMARIZE ( fact_demand_forecast, fact_demand_forecast[product_key], fact_demand_forecast[target_date_key], fact_demand_forecast[horizon_days] ),",
              "            fact_demand_forecast[actual_complete] = TRUE (), ALLSELECTED ( dim_model ) ),",
              "        CALCULATE ( DISTINCTCOUNT ( fact_demand_forecast[model_key] ), fact_demand_forecast[actual_complete] = TRUE (), ALLSELECTED ( dim_model ) ) = NModels )",
              "RETURN DIVIDE (",
              "    CALCULATE ( SUM ( fact_demand_forecast[absolute_error] ), fact_demand_forecast[actual_complete] = TRUE (), KEEPFILTERS ( CommonKeys ) ),",
              "    CALCULATE ( SUM ( fact_demand_forecast[actual_quantity] ), fact_demand_forecast[actual_complete] = TRUE (), KEEPFILTERS ( CommonKeys ) ) )"
            ],
            "formatString": "0.0%;-0.0%;0.0%",
            "lineageTag": "335a5c7984fb322875c50df244ac3b76"
          },
          {
            "name": "Recommended Qty Today",
            "displayFolder": "4. Đặt hàng NCC",
            "expression": "CALCULATE ( SUM ( fact_replenishment_daily[recommended_order_qty] ), fact_replenishment_daily[Is Latest Evaluation] = TRUE (), REMOVEFILTERS ( dim_date ) )",
            "formatString": "#,0",
            "lineageTag": "b52fdd70d9e8bc03162721cc3ae98948"
          },
          {
            "name": "Order Value Today",
            "displayFolder": "4. Đặt hàng NCC",
            "expression": "CALCULATE ( SUM ( fact_replenishment_daily[order_value_at_selling_price] ), fact_replenishment_daily[Is Latest Evaluation] = TRUE (), REMOVEFILTERS ( dim_date ) )",
            "lineageTag": "e6ea8c58dc955ff7468bc2bcec932806",
            "formatStringDefinition": {
              "expression": "VAR v = SELECTEDMEASURE ()\nVAR a = ABS ( v )\nVAR t =\n    SWITCH ( TRUE (),\n        a >= 1E9, FORMAT ( v / 1E9, \"#,0.0\" ) & \" tỷ ₫\",\n        a >= 1E6, FORMAT ( v / 1E6, \"#,0.0\" ) & \" triệu ₫\",\n        a >= 1E3, FORMAT ( v / 1E3, \"#,0\" ) & \" nghìn ₫\",\n        FORMAT ( v, \"#,0\" ) & \" ₫\" )\nRETURN \"\"\"\" & t & \"\"\"\""
            }
          },
          {
            "name": "SKUs Order Now",
            "displayFolder": "4. Đặt hàng NCC",
            "expression": "CALCULATE ( [SKUs Tracked Today], fact_replenishment_daily[urgency] = \"Đặt ngay\" )",
            "formatString": "#,0",
            "lineageTag": "33d6def54739c4c5cca3bdd6656e5d5d"
          },
          {
            "name": "SKUs Order This Week",
            "displayFolder": "4. Đặt hàng NCC",
            "expression": "CALCULATE ( [SKUs Tracked Today], fact_replenishment_daily[urgency] = \"Đặt trong tuần\" )",
            "formatString": "#,0",
            "lineageTag": "031062ea3745560692202ca1f50c8e2f"
          },
          {
            "name": "SKUs Default Lead Time",
            "displayFolder": "4. Đặt hàng NCC",
            "expression": "CALCULATE ( [SKUs Tracked Today], fact_replenishment_daily[lead_time_defaulted] = TRUE () )",
            "formatString": "#,0",
            "lineageTag": "ed4bc7bb599a2e7fe583693e59240f29"
          },
          {
            "name": "Recommended Qty",
            "displayFolder": "4. Đặt hàng NCC",
            "expression": "SUM ( fact_replenishment_daily[recommended_order_qty] )",
            "formatString": "#,0",
            "lineageTag": "222c173f8a4bc945d8c85b16132bc936"
          },
          {
            "name": "Last Order Created",
            "displayFolder": "5. Độ tin cậy",
            "expression": "FORMAT ( CALCULATE ( MAX ( fact_sales_line[create_time] ), ALL ( fact_sales_line ) ), \"dd/MM/yyyy HH:mm\" )",
            "lineageTag": "f6fb6c4f3727275b0e78476a145bc3fb"
          },
          {
            "name": "Selected SKU",
            "displayFolder": "6. Chi tiết SKU",
            "expression": "IF ( HASONEVALUE ( dim_product[sku] ), SELECTEDVALUE ( dim_product[product_name] ), \"Hãy chọn 1 SKU\" )",
            "lineageTag": "5274e0c2d7b9a72e767a0ce8bd1d0f3a"
          },
          {
            "name": "SKU Stock On Hand",
            "displayFolder": "6. Chi tiết SKU",
            "expression": "IF ( HASONEVALUE ( dim_product[sku] ), [Stock On Hand Today] )",
            "formatString": "#,0",
            "lineageTag": "fea66ef7b7f45eb2d22dae45c90fee06"
          },
          {
            "name": "SKU Days Of Cover",
            "displayFolder": "6. Chi tiết SKU",
            "expression": "IF ( HASONEVALUE ( dim_product[sku] ), [Days Of Cover Today] )",
            "formatString": "#,0.0",
            "lineageTag": "75fb4596ef0889beb46912a13c1b8892"
          },
          {
            "name": "SKU Recommended Qty",
            "displayFolder": "6. Chi tiết SKU",
            "expression": "IF ( HASONEVALUE ( dim_product[sku] ), [Recommended Qty Today] )",
            "formatString": "#,0",
            "lineageTag": "b0d2826df7c9b8c68ef636aa4db881c0"
          },
          {
            "name": "SKU Reason",
            "displayFolder": "6. Chi tiết SKU",
            "expression": "IF ( HASONEVALUE ( dim_product[sku] ), [Reason Today], \"Lý do hiển thị khi chọn 1 SKU\" )",
            "lineageTag": "5ef41341c8eb48763bea500fdd37cd75"
          },
          {
            "name": "SKU Actual Units",
            "displayFolder": "6. Chi tiết SKU",
            "expression": "IF ( HASONEVALUE ( dim_product[sku] ), [Actual Units] )",
            "formatString": "#,0",
            "lineageTag": "6f17dc84970438cf202028a3ac692fab"
          },
          {
            "name": "SKU Forecast Units",
            "displayFolder": "6. Chi tiết SKU",
            "expression": "IF ( HASONEVALUE ( dim_product[sku] ), [Forecast Units] )",
            "formatString": "#,0.0",
            "lineageTag": "4227c01b2a1aef3da747af7f8b4b7de5"
          },
          {
            "name": "SKU Stock Snapshot",
            "displayFolder": "6. Chi tiết SKU",
            "expression": "IF ( HASONEVALUE ( dim_product[sku] ), [Stock Snapshot] )",
            "formatString": "#,0",
            "lineageTag": "f14d53d7f29ef82ea31ccb369f1f72aa"
          },
          {
            "name": "SKU Day On Hand",
            "displayFolder": "6. Chi tiết SKU",
            "expression": "IF ( HASONEVALUE ( dim_product[sku] ) && HASONEVALUE ( dim_date[full_date] ), SUM ( fact_replenishment_daily[on_hand] ) )",
            "formatString": "#,0",
            "lineageTag": "693e10966f10889eb95ae12144f043b4"
          },
          {
            "name": "SKU Day Reorder Point",
            "displayFolder": "6. Chi tiết SKU",
            "expression": "IF ( HASONEVALUE ( dim_product[sku] ) && HASONEVALUE ( dim_date[full_date] ), SUM ( fact_replenishment_daily[reorder_point] ) )",
            "formatString": "#,0",
            "lineageTag": "009f561d230f86a142a48dfe5f16b7da"
          },
          {
            "name": "SKU Day Recommended",
            "displayFolder": "6. Chi tiết SKU",
            "expression": "IF ( HASONEVALUE ( dim_product[sku] ) && HASONEVALUE ( dim_date[full_date] ), SUM ( fact_replenishment_daily[recommended_order_qty] ) )",
            "formatString": "#,0",
            "lineageTag": "63c65d354938786ef63731ecd1d94647"
          },
          {
            "name": "Last Confirmed Day",
            "displayFolder": "5. Độ tin cậy",
            "expression": "FORMAT ( CALCULATE ( MAX ( dim_date[full_date] ), dim_date[is_data_confirmed] = TRUE (), ALL ( dim_date ) ), \"dd/MM/yyyy\" )",
            "lineageTag": "cb43550015f9307537946dcf563ae1a5"
          },
          {
            "name": "Header Conflict Orders",
            "displayFolder": "5. Độ tin cậy",
            "expression": "CALCULATE ( COUNTROWS ( fact_sales_order ), fact_sales_order[has_header_conflict] = TRUE () )",
            "formatString": "#,0",
            "lineageTag": "78f3524179e09640f3187db3358c419f"
          }
        ],
        "partitions": [
          {
            "name": "_Measures",
            "mode": "import",
            "source": {
              "expression": "ROW ( \"Value\", 0 )",
              "type": "calculated"
            }
          }
        ]
      }
    ]
  }
}
