# =============================================================
# File mẫu cấu hình môi trường. Copy file này thành `.env` rồi
# chỉnh sửa giá trị theo máy của bạn. KHÔNG commit file `.env`
# thật lên Git (đã được khai báo trong .gitignore).
# =============================================================

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS_INTERNAL=kafka:9092       # dùng giữa các container
KAFKA_BOOTSTRAP_SERVERS_HOST=localhost:29092      # dùng khi chạy Python ngoài Docker
KAFKA_TOPIC_ORDERS=ecom.orders.raw
KAFKA_TOPIC_INVENTORY=inventory.logs
INVENTORY_SNAPSHOT_INTERVAL=60                    # giây giữa 2 lần producer gửi snapshot tồn kho

# --- Múi giờ nghiệp vụ (phân vùng MinIO, ngày đặt hàng, Dim_Dates) ---
BUSINESS_TZ=Asia/Ho_Chi_Minh

# --- MinIO ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT_HOST=localhost:9000                # dùng khi chạy Python ngoài Docker
MINIO_BUCKET_RAW=ecom-raw-lake
MINIO_SECURE=false

# --- PostgreSQL ---
POSTGRES_USER=ecom
POSTGRES_PASSWORD=ecom_password
POSTGRES_DB=ecom_warehouse
POSTGRES_HOST=localhost                           # dùng khi chạy Python ngoài Docker
POSTGRES_PORT=5432
MLFLOW_DB=mlflow                                  # database riêng cho metadata MLflow

# --- FastAPI Serving (chuẩn bị cho Tuần 7) ---
API_HOST=0.0.0.0
API_PORT=8000
CORS_ALLOW_ORIGINS=*                              # danh sách origin, phân tách bằng dấu phẩy
MODEL_RELOAD_TOKEN=                               # nếu đặt: POST /model/reload cần header X-Reload-Token
SERVING_RELOAD_URL=http://localhost:8000/model/reload   # trigger_retraining gọi sau khi retrain

# --- MLflow (Kích hoạt Tuần 5) ---
MLFLOW_PORT=5000
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_S3_ENDPOINT_URL=http://localhost:9000
MLFLOW_EXPERIMENT_NAME=demand-forecasting-baseline
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

# --- Apache NiFi (Trực quan hóa luồng dữ liệu) ---
NIFI_PORT=8080
NIFI_USERNAME=admin
NIFI_PASSWORD=adminadmin1234

# --- Grafana ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
