# =============================================================
# File mẫu cấu hình môi trường. Copy file này thành `.env` rồi
# chỉnh sửa giá trị theo máy của bạn. KHÔNG commit file `.env`
# thật lên Git (đã được khai báo trong .gitignore).
# =============================================================

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS_INTERNAL=kafka:9092       # dùng giữa các container
KAFKA_BOOTSTRAP_SERVERS_HOST=localhost:29092      # dùng khi chạy Python ngoài Docker
KAFKA_TOPIC_ORDERS=ecom.orders.raw
KAFKA_TOPIC_INVENTORY=inventory.logs

# --- MinIO ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT_HOST=localhost:9000                # dùng khi chạy Python ngoài Docker
MINIO_BUCKET_RAW=ecom-raw-lake
MINIO_SECURE=false

# --- PostgreSQL ---
POSTGRES_USER=ecom
POSTGRES_PASSWORD=ecom_password
POSTGRES_DB=ecom_warehouse
POSTGRES_HOST=localhost                           # dùng khi chạy Python ngoài Docker
POSTGRES_PORT=5432

# --- FastAPI Serving (chuẩn bị cho Tuần 7) ---
API_HOST=0.0.0.0
API_PORT=8000

# --- MLflow (Kích hoạt Tuần 5) ---
MLFLOW_PORT=5000
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_S3_ENDPOINT_URL=http://localhost:9000
MLFLOW_EXPERIMENT_NAME=demand-forecasting-baseline
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

# --- Apache NiFi (Trực quan hóa luồng dữ liệu) ---
NIFI_PORT=8080
